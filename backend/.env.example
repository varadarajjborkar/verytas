# Copy to .env (gitignored). Every key is optional; without them the pipeline
# runs with offline stand-ins and the review records which checks were degraded.

# LLM work (claim extraction, explanations, fixes). Ollama Cloud is the default.
OLLAMA_API_KEY=
# VERYTAS_OLLAMA_MODEL=gpt-oss:120b
# VERYTAS_OLLAMA_FAST_MODEL=gpt-oss:20b

# Judge for semantic rules and intent checks (TypeSafe Jev).
TYPESAFE_API_KEY=

# Optional alternative LLM backend.
# VERYTAS_LLM_BACKEND=claude
# ANTHROPIC_API_KEY=

# Storage. SQLite by default; use Postgres in deployment.
# VERYTAS_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/verytas

# Error monitoring (errors only; never request bodies or PII).
# SENTRY_DSN=
