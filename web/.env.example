# Verytas backend (optional; without it the UI shows labelled demo data).
# With it set, everyone signs in at /signin with their own API token.
VERYTAS_API_URL=http://localhost:8000
# Local development only: VERYTAS_DEV_AUTOLOGIN=1 signs every visitor in with
# VERYTAS_API_TOKEN. Ignored in production builds; never set it on a shared host.
VERYTAS_DEV_AUTOLOGIN=
VERYTAS_API_TOKEN=

# Ollama Cloud key for "Ask Verytas" (server-side only)
OLLAMA_API_KEY=
OLLAMA_COPILOT_MODEL=gpt-oss:120b
