# Verytas backend (optional; without it the UI shows labelled demo data).
VERYTAS_API_URL=http://localhost:8000
# Service token used for every visitor while sign-in is off.
VERYTAS_API_TOKEN=
# Sign-in at /signin with each person's own token. Off by default; turn it on
# (=1) before the console is reachable by anyone else. With it on,
# VERYTAS_DEV_AUTOLOGIN=1 still uses the service token, outside production only.
VERYTAS_REQUIRE_SIGNIN=
VERYTAS_DEV_AUTOLOGIN=

# Ollama Cloud key for "Ask Verytas" (server-side only)
OLLAMA_API_KEY=
OLLAMA_COPILOT_MODEL=gpt-oss:120b
