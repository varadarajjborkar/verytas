[Unit]
Description=Verytas API
After=network-online.target
Wants=network-online.target

[Service]
User=verytas
WorkingDirectory=/srv/verytas/app/backend
EnvironmentFile=/srv/verytas/etc/api.env
Environment=HOME=/srv/verytas
ExecStart=/srv/verytas/venv/bin/uvicorn verytas.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
ReadWritePaths=/srv/verytas/data /srv/verytas/.cache
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
