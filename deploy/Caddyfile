15-252-228-168.sslip.io {
	encode zstd gzip
	# Uploads (video) go to 150 MB in the app; a little headroom for the multipart envelope.
	request_body {
		max_size 160MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The microphone is for the creator's spoken brief (BriefBox), on this site only; nothing else may ask.
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}
	# The MCP endpoint (docs/mcp.md) belongs to the API, not the web app, so it is the one path sent there.
	# Nothing else of the API is public: the web app reaches it on the loopback address. The API checks the
	# personal token and the Origin header itself; a request with a body over 1 MB is refused here first.
	@mcp path /mcp /mcp/
	handle @mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
